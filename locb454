local ACState = {
    Enabled = false,
    Grab = false,
    Ragdoll = false,
    Selected = {},
    BodyOffset = CFrame.new(0, 0, -5),
    Rotation = {
        ["Right Arm"] = Vector3.zero, ["Left Arm"] = Vector3.zero,
        ["Right Leg"] = Vector3.zero, ["Left Leg"] = Vector3.zero,
