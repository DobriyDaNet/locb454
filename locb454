local bbName = "Boombox"
local bbEn = false
local bbThread = nil
local bbCur = nil
local bbOff = CFrame.new(0, 1.0, 1.0) * CFrame.Angles(0, math.rad(180), 0)

local function RemoveBB()
    if bbCur and bbCur.Parent then
        pcall(function() RS.MenuToys.DestroyToy:FireServer(bbCur) end)
    end
    bbCur = nil
end

local function SpawnBB()
    local ch = LP.Character
    if not ch then return nil end
    local rp = ch:FindFirstChild("HumanoidRootPart")
    if not rp then return nil end
    local sR = RS:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    pcall(function() sR:InvokeServer(bbName, rp.CFrame * CFrame.new(0, 5, 0), Vector3.zero) end)
    task.wait()
    local fd = WS:FindFirstChild(LP.Name .. "SpawnedInToys")
    if fd then
        for _, c in ipairs(fd:GetChildren()) do
            if c.Name == bbName then return c end
        end
    end
    return nil
end

local function GetBBMain(b)
    if not b then return nil end
    if b:IsA("BasePart") then return b end
    local sp = b:FindFirstChild("SoundPart")
    if sp and sp:IsA("BasePart") then return sp end
    if b.PrimaryPart then return b.PrimaryPart end
    return b:FindFirstChildWhichIsA("BasePart")
end

local function GetBBOwner(b)
    if not b then return nil end
    local pt = b:FindFirstChild("SoundPart") or b:FindFirstChildWhichIsA("BasePart")
    if not pt then return nil end
    local o = pt:FindFirstChild("PartOwner")
    if o and o:IsA("ObjectValue") then return o.Value end
    return nil
end

local function WeldBB(b)
    if not b or not b.Parent then return end
    local ch = LP.Character
    if not ch then return end
    local bp = ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
    if not bp then return end
    local mp = GetBBMain(b)
    if not mp then return end

    for _, o in ipairs(bp:GetChildren()) do
        if o.Name == "BoomboxWeld" or o.Name == "BoomboxPartWeld" then o:Destroy() end
    end
    for _, pt in ipairs(b:GetDescendants()) do
        if pt:IsA("BasePart") then
            for _, o in ipairs(pt:GetChildren()) do
                if o.Name == "BoomboxWeld" or o.Name == "BoomboxPartWeld" then o:Destroy() end
            end
        end
    end

    for _, pt in pairs(b:GetDescendants()) do
        if pt:IsA("BasePart") then
            pt.CanCollide = false; pt.CanQuery = false; pt.CanTouch = false
            pt.Massless = true; pt.Anchored = false
            pt.AssemblyLinearVelocity = Vector3.zero; pt.AssemblyAngularVelocity = Vector3.zero
            pcall(function() pt.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0) end)
            for _, c in ipairs(pt:GetChildren()) do
                if c.Name ~= "BoomboxWeld" and c.Name ~= "BoomboxPartWeld" then
                    if c:IsA("BodyPosition") or c:IsA("BodyGyro") or c:IsA("BodyVelocity")
                        or c:IsA("BodyAngularVelocity") or c:IsA("BodyForce") or c:IsA("BodyThrust")
                        or c:IsA("VectorForce") or c:IsA("Torque") or c:IsA("LinearVelocity")
                        or c:IsA("AngularVelocity") or c:IsA("AlignPosition") or c:IsA("AlignOrientation")
                        or c:IsA("AlignConstraint") or c:IsA("Weld") or c:IsA("WeldConstraint")
                        or c:IsA("Motor6D") or c:IsA("Snap") then
                        c:Destroy()
                    end
                end
            end
        end
    end

    mp.CFrame = bp.CFrame * bbOff
    mp.AssemblyLinearVelocity = Vector3.zero
    mp.AssemblyAngularVelocity = Vector3.zero
    task.wait()

    for _, pt in pairs(b:GetDescendants()) do
        if pt:IsA("BasePart") then
            if pt == mp then
                local w = Instance.new("Weld")
                w.Name = "BoomboxWeld"
                w.Part0 = bp; w.Part1 = mp
                w.C0 = bbOff; w.C1 = CFrame.new(0, 0, 0)
                w.Parent = bp
            else
                local w = Instance.new("Weld")
                w.Name = "BoomboxPartWeld"
                w.Part0 = mp; w.Part1 = pt
                w.C0 = mp.CFrame:ToObjectSpace(pt.CFrame)
                w.C1 = CFrame.new(0, 0, 0)
                w.Parent = mp
            end
        end
    end
end

