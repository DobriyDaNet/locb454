for name in pairs(ACPoses) do table.insert(presetNames, name) end
table.sort(presetNames)

posGP:AddDropdown("ACPreset", {
    Text = "Preset", Values = presetNames, Default = 1,
    Callback = function(v)
        local pose = ACPoses[v]
        if pose then ACApplyPose(pose) end
    end
})

posGP:AddButton({ Text = "Apply Preset", Func = function()
    local v = posGP:GetValue("ACPreset")
    local pose = ACPoses[v]
    if pose then ACApplyPose(pose) end
end })

posGP:AddButton({ Text = "Reset Pose", Func = function() ACApplyPose(ACPoses.Default) end })

local offsetTab = posGR:AddTab("Offset", "move-diagonal")
local rotationTab = posGR:AddTab("Rotation", "refresh-cw")

local rotLimbs = {"Torso", "Right Leg", "Left Leg", "Right Arm", "Left Arm", "Head"}
local offLimbs = {"Right Leg", "Left Leg", "Right Arm", "Left Arm", "Head"}

offsetTab:AddDropdown("ACLimbO", { Text = "Select Limb", Values = offLimbs, Default = 1 })
for _, limb in ipairs(offLimbs) do
    local box = offsetTab:AddDependencyBox()
    box:SetupDependencies({{offsetTab.Toggles.ACLimbO, limb}})
    for _, ax in ipairs({"X","Y","Z"}) do
        box:AddSlider("ACO_" .. limb .. "_" .. ax, {
            Text = ax .. " Offset",
            Min = -5, Max = 5, Default = ACState.Offsets[limb][ax], Rounding = 1,
            Callback = function(v)
                local cur = ACState.Offsets[limb]
                local new
                if ax == "X" then new = Vector3.new(v, cur.Y, cur.Z)
                elseif ax == "Y" then new = Vector3.new(cur.X, v, cur.Z)
                else new = Vector3.new(cur.X, cur.Y, v) end
                ACState.Offsets[limb] = new
            end
        })
    end
end

rotationTab:AddDropdown("ACLimbR", { Text = "Select Limb", Values = rotLimbs, Default = 1 })
for _, limb in ipairs(rotLimbs) do
    local box = rotationTab:AddDependencyBox()
    box:SetupDependencies({{rotationTab.Toggles.ACLimbR, limb}})
    for _, ax in ipairs({"X","Y","Z"}) do
        box:AddSlider("ACR_" .. limb .. "_" .. ax, {
            Text = ax .. " Rotation",
            Min = -180, Max = 180, Default = 0, Rounding = 1,
            Callback = function(v)
                local cur = ACState.Rotation[limb]
                local new
                if ax == "X" then new = Vector3.new(v, cur.Y, cur.Z)
                elseif ax == "Y" then new = Vector3.new(cur.X, v, cur.Z)
                else new = Vector3.new(cur.X, cur.Y, v) end
                ACState.Rotation[limb] = new
            end
        })
    end
end

posG:AddSlider("ACBodyX", { Text = "Body X", Min = -10, Max = 10, Default = 0, Rounding = 1,
    Callback = function(v) ACState.BodyOffset = CFrame.new(v, ACState.BodyOffset.Y, ACState.BodyOffset.Z) end })
posG:AddSlider("ACBodyY", { Text = "Body Y", Min = -5, Max = 20, Default = 0, Rounding = 1,
    Callback = function(v) ACState.BodyOffset = CFrame.new(ACState.BodyOffset.X, v, ACState.BodyOffset.Z) end })
posG:AddSlider("ACBodyZ", { Text = "Body Z", Min = -10, Max = 10, Default = -5, Rounding = 1,
    Callback = function(v) ACState.BodyOffset = CFrame.new(ACState.BodyOffset.X, ACState.BodyOffset.Y, v) end })

