        ["Right Arm"] = Vector3.new(1,0.5,0), ["Left Arm"] = Vector3.new(-1,0.5,0),
        Head = Vector3.new(0,1,0),
    },
    Transparency = 0,
    Thread = nil,
    States = setmetatable({}, {__mode = "k"}),
}

local ACLimbs = {"Torso", "Right Leg", "Left Leg", "Right Arm", "Left Arm", "Head"}

local function ACChar(p)
    p = p or LP
    local ch = p.Character
    if not ch then return nil, nil, nil end
    return ch, ch:FindFirstChild("HumanoidRootPart"), ch:FindFirstChild("Humanoid")
end

local function ACGrab(part, offsetCF)
    local _, root, hum = ACChar()
    if not root or not hum or hum.Health <= 0 or not part or not part.Parent then return end
    local target = (offsetCF or root.CFrame) * CFrame.new(0, 1.593, 0)
    local cf = part.CFrame
    cf = CFrame.new(target.Position, cf.Position)
    pcall(function() RS.GrabEvents.SetNetworkOwner:FireServer(part, cf) end)
end

local function ACIsOwner(part)
    if not part or not part.Parent then return false end
    local o = part:FindFirstChild("PartOwner")
    return o and o.Value == LP
end

local function ACSNO(part, timeout)
    local _, root, hum = ACChar()
    if not hum or hum.Health <= 0 or not root or not part or not part.Parent then return false end
    if ACIsOwner(part) then return true end
    timeout = timeout or 0.65
    local start = tick()
    while part.Parent and not ACIsOwner(part) and hum.Health > 0 and root.Parent and tick() - start < timeout do
        ACGrab(part)
        RUN.Heartbeat:Wait()
    end
    return ACIsOwner(part)
end

local function ACCleanup(p)
    local st = ACState.States[p]
    ACState.States[p] = nil
    if not st then return end
    if st.TransparencyConnection then st.TransparencyConnection:Disconnect() end
    for part, t in pairs(st.Transparency) do
        if part.Parent then part.LocalTransparencyModifier = t end
    end
    local ch = st.Character
    if ch then
        local torso = ch:FindFirstChild("Torso")
        if torso then
            local bp = torso:FindFirstChild("AutoClickerBP")
            local bg = torso:FindFirstChild("AutoClickerBG")
            if bp then bp:Destroy() end
            if bg then bg:Destroy() end
        end
        for _, limbName in ipairs(ACLimbs) do
            local part = ch:FindFirstChild(limbName)
            if part then
                if limbName == "Torso" or limbName == "Head" then part.CanCollide = true end
                local socket = part:FindFirstChild("BallSocketConstraint")
                if socket then socket.LimitsEnabled = true; socket.TwistLimitsEnabled = true end
                local gyro = part:FindFirstChild("AutoClickerBG")
                if gyro then gyro:Destroy() end
            end
        end
    end
end

local function ACApplyPose(pose)
    if not pose then return end
    if pose.BodyPos then
        ACState.BodyOffset = CFrame.new(pose.BodyPos[1] or 0, pose.BodyPos[2] or 0, pose.BodyPos[3] or -5)
    end
    for _, limb in ipairs({"Right Arm","Left Arm","Right Leg","Left Leg","Head","Torso"}) do
        local r = pose[limb]
        if r then ACState.Rotation[limb] = Vector3.new(r[1] or 0, r[2] or 0, r[3] or 0) end
    end
end

local function ACStart()
    if ACState.Thread then task.cancel(ACState.Thread) end
    ACState.Thread = task.spawn(function()
        while ACState.Enabled do
            local char, root, hum = ACChar()
            local _, centerRoot, centerHum = ACChar(LP)
            local centerTorso = char and char:FindFirstChild("Torso")

            for p in pairs(ACState.States) do
                if not ACState.Selected[p] then ACCleanup(p) end
            end

            if char and root and hum and hum.Health > 0 then
                local myTorso = char:FindFirstChild("Torso")
                if myTorso then myTorso.CanCollide = false end
                local myHead = char:FindFirstChild("Head")
                if myHead then myHead.CanCollide = false end

                for player in pairs(ACState.Selected) do
                    if player ~= LP and player.Parent and player.Character then
                        local tch = player.Character
                        local tRoot = tch:FindFirstChild("HumanoidRootPart")
                        local tHum = tch:FindFirstChild("Humanoid")
                        local tTorso = tch:FindFirstChild("Torso")
                        if tRoot and tHum and tHum.Health > 0 and tTorso and centerRoot and centerHum and centerHum.Health > 0 and centerTorso then
                            -- ТЕЛЕПОРТ К ЦЕЛИ как в кике
                            local dist = (centerRoot.Position - tTorso.Position).Magnitude
                            if dist > 25 then
                                centerRoot.CFrame = tTorso.CFrame * CFrame.new(0, 0, 2)
                                centerRoot.Velocity = Vector3.zero
                            end

                            local st = ACState.States[player]
                            if st and st.Character ~= tch then ACCleanup(player); st = nil end

                            if not st then
                                st = {
                                    Character = tch,
                                    Gyros = {}, GyroTargets = {}, Parts = {},
                                    Sockets = {}, SocketAttachments = {}, LimbOffsets = {},
                                    RotationValues = {}, RotationFrames = {},
                                    Transparency = {},
                                }
                                ACState.States[player] = st

                                st.TransparencyConnection = tch.DescendantAdded:Connect(function(desc)
                                    if ACState.States[player] ~= st or not desc:IsA("BasePart") then return end
                                    st.Transparency[desc] = desc.LocalTransparencyModifier
                                    desc.LocalTransparencyModifier = ACState.Transparency
                                end)

                                for _, part in tch:GetChildren() do
                                    if part:IsA("BasePart") then part.CanCollide = false end
                                end

                                for _, limbName in ipairs(ACLimbs) do
                                    local part = tch:FindFirstChild(limbName)
                                    if part then
                                        st.Parts[limbName] = part
                                        local socket = part:FindFirstChild("BallSocketConstraint")
                                        st.Sockets[limbName] = socket
                                        st.SocketAttachments[limbName] = socket and socket.Attachment1
                                    end
                                end
                            end

                            for _, part in tch:GetChildren() do
                                if part:IsA("BasePart") then
                                    if st.Transparency[part] == nil then st.Transparency[part] = part.LocalTransparencyModifier end
                                    part.LocalTransparencyModifier = ACState.Transparency
                                end
                            end

                            local bp = st.BodyPosition
                            if not bp or bp.Parent ~= tTorso then
                                bp = tTorso:FindFirstChild("AutoClickerBP") or Instance.new("BodyPosition")
                                bp.Name = "AutoClickerBP"
                                bp.D = 450
                                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bp.Parent = tTorso
                                st.BodyPosition = bp
                                st.BodyTarget = nil
                            end

                            local targetPos = (centerRoot.CFrame * ACState.BodyOffset).Position
                            if st.BodyTarget ~= targetPos then
                                bp.Position = targetPos
                                st.BodyTarget = targetPos
                            end

                            local lookCF = CFrame.lookAt(
                                tTorso.Position,
                                Vector3.new(centerTorso.Position.X, tTorso.Position.Y, centerTorso.Position.Z)
                            )

                            for _, limbName in ipairs(ACLimbs) do
                                local part = st.Parts[limbName]
                                if not part or part.Parent ~= tch then
                                    part = tch:FindFirstChild(limbName)
                                    st.Parts[limbName] = part
                                    st.Gyros[limbName] = nil
                                    st.GyroTargets[limbName] = nil
                                    if part then
                                        local socket = part:FindFirstChild("BallSocketConstraint")
                                        st.Sockets[limbName] = socket
                                        st.SocketAttachments[limbName] = socket and socket.Attachment1
                                    end
                                end
                                if part then
                                    part.CanCollide = false
                                    local socket = st.Sockets[limbName]
                                    if socket then
                                        socket.LimitsEnabled = false
                                        socket.TwistLimitsEnabled = false
                                        local off = ACState.Offsets[limbName]
                                        local attach = st.SocketAttachments[limbName]
                                        if off and attach and st.LimbOffsets[limbName] ~= off then
                                            attach.Position = off
                                            st.LimbOffsets[limbName] = off
                                        end
                                    end
                                    local gyro = st.Gyros[limbName]
                                    if not gyro or gyro.Parent ~= part then
                                        gyro = part:FindFirstChild("AutoClickerBG") or Instance.new("BodyGyro")
                                        gyro.Name = "AutoClickerBG"
                                        gyro.D = 500
                                        gyro.P = 7500
                                        gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                                        gyro.Parent = part
                                        st.Gyros[limbName] = gyro
                                        st.GyroTargets[limbName] = nil
                                    end
                                    local rot = ACState.Rotation[limbName] or Vector3.zero
                                    if st.RotationValues[limbName] ~= rot then
                                        st.RotationValues[limbName] = rot
                                        st.RotationFrames[limbName] = CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
                                    end
                                    local rotCF = st.RotationFrames[limbName]
                                    local targetCF
                                    if limbName == "Torso" then targetCF = lookCF * rotCF
                                    else targetCF = tTorso.CFrame * rotCF end
                                    if st.GyroTargets[limbName] ~= targetCF then
                                        gyro.CFrame = targetCF
                                        st.GyroTargets[limbName] = targetCF
                                    end
                                end
                            end

                            if ACState.Grab then
                                ACSNO(tTorso)
                            end

                            if ACState.Ragdoll then
                                local rd = tHum:FindFirstChild("Ragdolled")
                                if rd and not rd.Value then
                                    pcall(function()
                                        RS.CharacterEvents.RagdollRemote:FireServer(tRoot, 0)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
            RUN.Heartbeat:Wait()
        end
    end)
end

local function ACStop()
    ACState.Enabled = false
    for p in pairs(ACState.States) do ACCleanup(p) end
end

