local function FastKick()
    tarG:AddDropdown("KickMode", { Text = "Kick Mode", Values = {"Slow", "Normal", "Fast"}, Default = 3, Callback = function(v) kM = v end })
    tarG:AddSlider("KickDS", { Text = "DS LINE", Min = 0, Max = 0.2, Default = 0, Rounding = 3, Suffix = " sec", Callback = function(v) kDS = v end })
    tarG:AddSlider("KickH", { Text = "Kick Height (Y)", Min = 5, Max = 20, Default = 15, Suffix = " studs", Callback = function(v) kH = v end })
    tarG:AddSlider("KickOX", { Text = "Kick Offset X", Min = -10, Max = 10, Default = 0, Callback = function(v) kOX = v end })
    tarG:AddSlider("KickOZ", { Text = "Kick Offset Z", Min = -10, Max = 10, Default = 0, Callback = function(v) kOZ = v end })
    tarG:AddToggle("Kick", { Text = "Kick", Default = false, Callback = function(on)
        kEn = on
        if not on then return end
        task.spawn(function()
            while kEn do
                local t = tgtP
                if not t or not t.Parent then task.wait() continue end
                local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local tr = t.Character and t.Character:FindFirstChild("HumanoidRootPart")
                local th = t.Character and t.Character:FindFirstChild("Humanoid")
                if not mr or not tr or not th or th.Health <= 0 then task.wait() continue end

                local gI, useT
                if kM == "Fast" then gI = 0; useT = false
                elseif kM == "Normal" then gI = 1/500; useT = true
                else gI = 1/750; useT = true end

                local gE = RS:WaitForChild("GrabEvents")
                local sNO = gE:WaitForChild("SetNetworkOwner")
                local dG = gE:FindFirstChild("DestroyGrabLine")
                local cG = gE:FindFirstChild("CreateGrabLine")
                local aPs, aOs = {}, {}
                local aN = kM == "Slow" and 25 or 15
                local dT = nil

                pcall(function()
                    th:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    th:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
                    th:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
                end)
                th.Sit = false; th.PlatformStand = true
                th.AutoRotate = false; th.WalkSpeed = 0; th.JumpPower = 0

                local tBP = Instance.new("BodyPosition")
                tBP.MaxForce = Vector3.new(1e6, 1e6, 1e6); tBP.D = 500; tBP.P = 50000
                tBP.Position = tr.Position; tBP.Parent = tr
                local tBG = Instance.new("BodyGyro")
                tBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9); tBG.D = 500; tBG.P = 50000
                tBG.CFrame = CFrame.new(tr.Position); tBG.Parent = tr

                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 255, 255); hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.fromRGB(255, 255, 255); hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = t.Character; hl.Parent = t.Character

                if dG then
                    dT = task.spawn(function()
                        while kEn and t and t.Parent do
                            local tc = t.Character
                            local tr2 = tc and tc:FindFirstChild("HumanoidRootPart")
                            if not tr2 then task.wait() continue end
                            pcall(function() dG:FireServer(tr2) end)
                            if kDS > 0 then task.wait(kDS) else task.wait() end
                        end
                    end)
                end

                local gThread = task.spawn(function()
                    while kEn and t and t.Parent do
                        local tc2 = t.Character
                        local tr3 = tc2 and tc2:FindFirstChild("HumanoidRootPart")
                        local th3 = tc2 and tc2:FindFirstChild("Humanoid")
                        local mc2 = LP.Character
                        local mr2 = mc2 and mc2:FindFirstChild("HumanoidRootPart")
                        if tr3 and th3 and th3.Health > 0 and mr2 then
                            local tp = mr2.Position + Vector3.new(kOX, math.min(kH, 20), kOZ)
                            for _, pt in pairs(tc2:GetChildren()) do if pt:IsA("BasePart") then pcall(function() sNO:FireServer(pt, pt.CFrame) end) end end
                            pcall(function() sNO:FireServer(tr3, mr2.CFrame) end)
                            if cG then pcall(function() cG:FireServer(tr3, Vector3.zero, tp, false) end) end
                        end
                        if useT then task.wait(gI) else task.wait() end
                    end
                end)

                while kEn and t and t.Parent do
                    local tc = t.Character
                    local tr2 = tc and tc:FindFirstChild("HumanoidRootPart")
                    local th2 = tc and tc:FindFirstChild("Humanoid")
