local function SitTrain()
    if gcR then return end
    gcR = true
    local ch = LP.Character
    local hm = ch and ch:FindFirstChild("Humanoid")
    if not ch or not hm then gcR = false; return end
    local oc = ch:GetPivot()
    local tr = WS.Map.AlwaysHereTweenedObjects and WS.Map.AlwaysHereTweenedObjects:FindFirstChild("Train")
    local st = nil
    if tr then for _, c in pairs(tr:GetDescendants()) do if c:IsA("Seat") and c.Occupant == nil and c ~= lsD.LastSeat then lsD.LastSeat = c; st = c; break end end end
    if not st then gcR = false; return end
    st:Sit(hm)
    task.wait(0.5)
    hm.Sit = false
    ch:PivotTo(oc)
    gcR = false
end

